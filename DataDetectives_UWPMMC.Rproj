#Authors: Teckla Holmes Freya Amason Maria Strief

#Math Modeling Contest 2026

#Model based on averages to map out the following: 

#Model the total annual energy cost for the data center if it operates 100,000 (or 
#some other amount) racks at full capacity all year. (Note a 520 acre center has the capacity for almost 4 times that many racks)
#• The data center has 4,200,000 servers (42 servers per rack), each consuming an average of 450 W of power.
# The cooling system removes heat by evaporating water, where 1 liter of water can absorb approximately 2.26 MJ of heat during evaporation.
# The facility aims to keep the average internal temperature stable, meaning all heat generated must be removed.
#• Model the relationship between the total electrical power consumption, total heat generated, and the volume of water needed per day.
#• Calculate daily water usage in liters.
#• Suppose the data center implements a load-shifting strategy that reduces rack usage 
#by 20% during peak hours. Modify your model to estimate the new annual cost. 
#Data centers can shift energy use by increasing or limiting time being used to train models.
#• Analyze how water usage changes if the number of servers increases by 20% while 
#each server’s power consumption decreases by 10% due to efficiency upgrades.
#• Recommend how much should Meta be charged for energy and water usage. 


###############################

# Unit conversion 
AVG_ELEC_PER_KWH = 0.094
BTUS_PER_KW = 3412
BTUS_PER_MJ = 947.82
MJ_PER_1L_EVAP = 2.26
CUBIC_FEET_PER_LITER = 0.0353

HOURS_PER_YEAR = 8760
HOURS_PER_DAY = 24
DAYS_IN_YEAR = 365.25

#Presets for different questions
UPGRADE_SERVER_PERCENT = 1.2



#Server capacities at different times (High Rate, Reg Rate, Low Rate)
NAIVE_CAP_DIST = c(1.0, 1.0, 1.0)
SHIFT_CAP_DIST = c(0.8, 1.0, 1.0) #Servers run at 80% max for peak hours
UPGRADE_CAP_DIST = c(0.9, 0.9, 0.9) #All servers 10% more efficient

#Alliant's reported charges ($)
#Prices, as well as rate hours can be founds in the following offcial PDF
# https://share.google/x2O2o4FkEQXmv6SRM
HIGH_CHARGE = .09272
LOW_CHARGE = .03696
AVG_CHARGE = .04940

#Utility costs

#Cost for cubic foot of water according Beaver Dam ($)
# Prices are found a https://ci.beaverdam.wi.gov/270/Water-Sewer-Rates
FIXED_CHARGE = 1812 #Fixed quarterly charge ($) (assuming 6 inch meter)
T1_WATER_COST_FT3 = 0.0460 #Cost of first 6000 cubic feet
T2_WATER_COST_FT3 = 0.0427 #Cost of next 114,000 cubic feet (to 120,000)
T3_WATER_COST_FT3 = 0.0340 #Cost of all cubic feet after 120,000

T1_CUT_OFF = 6000
T2_CUT_OFF = 114000

SEWAGE_RATE = 0.0299 #Cost per cubic foot of discharge ($)

#Waste production metrics
#Numbers come from https://www.eesi.org/articles/view/data-centers-and-water-consumption (Evaporation)
#https://genesiswatertech.com/blog-post/data-center-water-usage-efficiency-guide/ (Average cycles)
PERCENT_EVAP = 0.8 #Percent of cooling water that is lost to evaportation
EST_CYCLES = 4 #Estimated number of times the same water is used

#Time Proportions
WEEKDAYS = 5/7
WEEKEND_DAYS = 2/7

PEAKHOURS = 6/24 #average between 8 hours for summer and 4 hours for winter
AVRG_PEAKHOURS = 15/168 #(5/7)((1/2)(3/24))

WS_REG_RATE_HOURS = 17/24 #hours during winter and summer
FS_REG_RATE_HOURS = 11/24 #hours during fall and spring
AVRG_REG_RATE_HOURS = 70/168 #(5/7)((1/2)(11/24 + 17/24))

WKDY_LOWHOURS = 7/24
AVRG_LOWHOURS = 83/168 #(5/7)(7/24) + (2/7)(24/24)

#Weekdays: (1/2)(6 hr/24 hr) + (1/2)(17 hr/24 hr + 11 hr/24 hr) + (7 hr/24 hr)
#= (1/2)((6 hr/24 hr) + (28 hr/24 hr)) + (7 hr/24 hr)
#= (1/2)(34 hr/24 hr) + (7 hr/24 hr)
#= (17 hr/24 hr) + (7 hr/24 hr)
#= 24 hr/24 hr

# Variable declaration

#Affect number of servers and how they're distributed
rackcount = 100000
servers_per_rack = 42

#Energry specifications
PUE = 1.45
kw_per_server = 0.450

#Heat specifications
site_heat_coef = 1.15 #Total site heat is site_heat_coef * IT heat
Mj_per_liter = MJ_PER_1L_EVAP #Liters need to remove one Mj of heat

#Water specifications
water_cycles = EST_CYCLES
replace_need_ratio = (PERCENT_EVAP * (water_cycles - 1) + 1)/water_cycles #Actual water used over liters needed
discarge_per_liter = (1 - PERCENT_EVAP) #Waste water per liter of water used (after accounting for above ratio)
water_capacity = 2/DAYS_IN_YEAR #Ratio of water stored to annual needs (currently assumes two days of raw need kept)

########
#Model the total annual energy cost for the data center if it operates 100,000 (or 
#some other amount) racks at full capacity all year. 
########

#Arranges the times and prices of each rate as a proportion of a day
#High, Reg, Low
rate_dist <- c(AVRG_PEAKHOURS, AVRG_REG_RATE_HOURS, AVRG_LOWHOURS)
charge_dist <- c(HIGH_CHARGE, AVG_CHARGE, LOW_CHARGE)
price_dist <- c(0, 0 ,0)

for (i in 1:3)
  {
    price_dist[i] <- rate_dist[i] * charge_dist[i]
  }

#Server capacities during each type of hour
cap_dist <- CHALLENGE_CAP_DIST

total_servers <- rackcount * servers_per_rack

#total_elec = PUE * (rackcount * SERVERS_PER_RACK * SERVER_CAP * KW_PER_SERVER) * HOURS_PER_YEAR
#Gives total power per year [1] and total cost per year [2]
find_total_elec <- function(PUE_var, tot_servers, rate_times, rate_prices, capacities, server_kw)
{  
  weight_dist <- c()
  max_total <- PUE_var * tot_servers * server_kw * HOURS_PER_YEAR


    for (i in 1:3)
    {
      weight_dist[i] <- rate_times[i] * capacities[i]
    }
    elec_sum <- 0
    cost_sum <- 0
    for (i in 1:3)
    {
      elec_sum <- elec_sum + (weight_dist[i] * max_total)
      cost_sum <- cost_sum + (weight_dist[i] * rate_prices[i] * max_total)
    }
    

    return(c(elec_sum, cost_sum))
}

#Total electric at full uptime (kWh):
naive_tot_elec <- find_total_elec(PUE, total_servers, rate_dist, charge_dist, NAIVE_CAP_DIST, kw_per_server)[1]
naive_tot_elec

#Total electric cost at full uptime ($):
naive_tot_elec_price <- find_total_elec(PUE, total_servers, rate_dist, charge_dist, NAIVE_CAP_DIST, kw_per_server)[2]
naive_tot_elec_price

#Total electric using a load shifting strategy (kWh):
dynamic_tot_elec <- find_total_elec(PUE, total_servers, rate_dist, charge_dist, SHIFT_CAP_DIST, kw_per_server)[1]
dynamic_tot_elec

#Total electric cost using a load shifting strategy ($):
dynamic_tot_elec_price <- find_total_elec(PUE, total_servers, rate_dist, charge_dist, SHIFT_CAP_DIST, KW_PER_SERVER)[2]
dynamic_tot_elec_price


#######
#Calculate daily water usage in liters.
#######
# Per https://gdchillers.com/resources/data-centers/how-to-calculate-data-center-cooling-requirements-step-by-step 
#We can assume that electricty consumption in IT puts out an equivalent amount of heat. 
#Facility load ranges between 1.05 to 1.15 time for heat generation per source, so you would find IT load, and multiply by 1.1  

#Finds total heat load per year (BTUs)
find_total_heat <- function(tot_servers, rate_times, capacities, server_kw)
{
  weight_dist <- c()
  max_total <- tot_servers * server_kw * site_heat_coef * BTUS_PER_KW * HOURS_PER_YEAR
  
  
  for (i in 1:3)
  {
    weight_dist[i] <- rate_times[i] * capacities[i]
  }
  
  heat_sum <- 0

  for (i in 1:3)
  {
    heat_sum <- heat_sum + (weight_dist[i] * max_total)
  }
  
  return(heat_sum)
  
}

#Finds amount of water needed to offput heat (l)
find_H2O_needed <-function(heat, water_ratio, Mj_per_l)
{
  liters_needed <- heat / (Mj_per_l * BTUS_PER_MJ)
  liters_needed <- liters_needed * water_ratio + (liters_needed * water_capacity)
  
  return(liters_needed)
}

#Finds price of water and sewage
find_H2O_price <- function(water_used)
{
  total_price <- FIXED_CHARGE
  ft3_used = water_used * CUBIC_FEET_PER_LITER
  
  #Finds the water cost by filling each bracket until all water is accounted for
  if(ft3_used >= T1_CUT_OFF)
  {
    total_price <- total_price + (T1_CUT_OFF * T1_WATER_COST_FT3)
    ft3_used <- ft3_used - T1_CUT_OFF
  }else
  {
    total_price <- total_price + (ft3_used * T1_WATER_COST_FT3)
    ft3_used = 0
    }
  
  if(ft3_used >= T2_CUT_OFF)
  {
    total_price <- total_price + (T2_CUT_OFF * T2_WATER_COST_FT3)
    ft3_used <- ft3_used - T2_CUT_OFF
  }else
  {
      total_price <- total_price + (T2_CUT_OFF * T2_WATER_COST_FT3)
      ft3_used <- 0
      }
  
  if(ft3_used > 0)
  {
    total_price <- total_price + (ft3_used * T3_WATER_COST_FT3)
  }
  
  sewage_cost = discarge_per_liter * (water_used * CUBIC_FEET_PER_LITER) * SEWAGE_RATE
  
  total_price <- total_price + sewage_cost
  
  return(total_price)
}

#Find heat produced at full uptime (BTU)
naive_tot_heat <- find_total_heat(total_servers, rate_dist, NAIVE_CAP_DIST, kw_per_server)
naive_tot_heat

#Find water needed at full uptime (L)
naive_tot_water <- find_H2O_needed(naive_tot_heat, replace_need_ratio, Mj_per_liter)
naive_tot_water

#Find water cost at full uptime ($)
naive_tot_water_price <- find_H2O_price(naive_tot_water)
naive_tot_water_price

#Find heat produced using a load shifting strategy (BTU)
dynamic_tot_heat <- find_total_heat(total_servers, rate_dist, SHIFT_CAP_DIST, kw_per_server)
dynamic_tot_heat

#Find water need using a load shifting strategy (L)
dynamic_tot_water <- find_H2O_needed(dynamic_tot_heat, replace_need_ratio, Mj_per_liter)
dynamic_tot_water

#Find water cost using a load shifting strategy ($)
dynamic_tot_water_price <- find_H2O_price(dynamic_tot_water)
dynamic_tot_water_price

#Power used for 20% increase in number of servers, and 10% power consumption decrease
upgrade_tot_elec <- find_total_elec(PUE, UPGRADE_SERVER_PERCENT * total_servers, rate_dist, charge_dist, SHIFT_CAP_DIST, kw_per_server)[1]
upgrade_tot_elec

#Power cost for 20% increase in number of servers, and 10% power consumption decrease
upgrade_tot_elec_cost <- find_total_elec(PUE, UPGRADE_SERVER_PERCENT * total_servers, rate_dist, charge_dist, SHIFT_CAP_DIST, kw_per_server)[2]
upgrade_tot_elec_cost

#Heat generated with 20% increase in number of servers, and 10% power consumption decrease
upgrade_tot_heat <- find_total_heat (UPGRADE_SERVER_PERCENT * tot_servers, rate_times, SHIFT_CAP_DIST, server_kw)
upgrade_tot_heat

#Water used with a 20% increase in number of servers, and 10% power consumption decrease
upgrade_tot_water <- find_H2O_needed(upgrade_tot_heat, replace_need_ratio, Mj_per_liter)
upgrade_tot_water

#Water price with a 20% increase in number of servers, and 10% power consumption decrease
upgrade_tot_water_price <- find_H2O_price(upgrade_tot_water)
upgrade_tot_water_price
